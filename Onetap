	local pill = Instance.new("TextButton")
	pill.Size = UDim2.new(0, 40, 0, 20)
	pill.Position = UDim2.new(1, -48, 0.5, -10)
	pill.BackgroundColor3 = state and ActiveTheme.Accent or Color3.fromRGB(51, 65, 85)
	pill.Text = ""
	pill.AutoButtonColor = false
	pill.Parent = row
	addCorner(pill, 99)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = pill
	addCorner(knob, 99)

	local function refreshVisual(animated)
		local targetPill = state and ActiveTheme.Accent or Color3.fromRGB(51, 65, 85)
		local targetKnob = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
		if animated then
			TweenService:Create(pill, TweenInfo.new(0.14), {BackgroundColor3 = targetPill}):Play()
			TweenService:Create(knob, TweenInfo.new(0.14), {Position = targetKnob}):Play()
		else
			pill.BackgroundColor3 = targetPill
			knob.Position = targetKnob
		end
	end

	local function setToggleState(newState, animated)
		state = newState and true or false
		refreshVisual(animated ~= false)
		if callback then
			callback(state)
		end
	end

	local bindSlot = {
		Label = labelText,
		Button = keyBtn,
		SetKey = function(newKey)
			if boundKey and featureKeybinds[boundKey] and featureKeybinds[boundKey].Button == keyBtn then
				featureKeybinds[boundKey] = nil
			end
			boundKey = newKey
			if newKey then
				featureKeybinds[newKey] = {
					Button = keyBtn,
					Toggle = function()
						setToggleState(not state, true)
					end
				}
				keyBtn.Text = newKey.Name
				keyBtn.TextColor3 = ActiveTheme.Fill
			else
				keyBtn.Text = "Bind"
				keyBtn.TextColor3 = Color3.fromRGB(148, 163, 184)
			end
		end,
		RefreshColor = function()
			if boundKey then
				keyBtn.TextColor3 = ActiveTheme.Fill
			end
		end
	}

	keyBtn.MouseButton1Click:Connect(function()
		playClickSound()
		listeningForMainKeybind = false
		activeFeatureBindSlot = bindSlot
		keyBtn.Text = "..."
		keyBtn.TextColor3 = Color3.fromRGB(248, 250, 252)
	end)

	table.insert(themedToggles, {
		Row = row,
		Pill = pill,
		Refresh = refreshVisual,
		RefreshBind = bindSlot.RefreshColor
	})

	toggleControllers[labelText] = {
		GetState = function() return state end,
		SetState = function(v) setToggleState(v, false) end,
		GetKeyName = function() return boundKey and boundKey.Name or nil end,
		SetKeyByName = function(kName)
			if typeof(kName) == "string" and kName ~= "" then
				local ok, kc = pcall(function() return Enum.KeyCode[kName] end)
				if ok and typeof(kc) == "EnumItem" then
					bindSlot.SetKey(kc)
					return
				end
			end
			bindSlot.SetKey(nil)
		end
	}

	pill.MouseButton1Click:Connect(function()
		playClickSound()
		setToggleState(not state, true)
	end)

	if callback then
		callback(state)
	end
end

local function addSlider(page, labelText, minVal, maxVal, increment, defaultVal, callback)
	increment = increment or 1
	local value = math.clamp(defaultVal or minVal, minVal, maxVal)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 44)
	frame.BackgroundColor3 = ActiveTheme.Row
	frame.BorderSizePixel = 0
