-- Cached Local Character References (avoids per-frame FindFirstChild overhead on mobile)
local cachedChar = nil
local cachedHum = nil
local cachedRoot = nil

local function refreshLocalCharCache(char)
	cachedChar = char
	cachedHum = char and char:FindFirstChildOfClass("Humanoid") or nil
	cachedRoot = char and char:FindFirstChild("HumanoidRootPart") or nil
	if char and not cachedHum then
		char.ChildAdded:Connect(function(child)
			if child:IsA("Humanoid") then
				cachedHum = child
			elseif child.Name == "HumanoidRootPart" then
				cachedRoot = child
			end
		end)
	end
end

if LocalPlayer and LocalPlayer.Character then
	refreshLocalCharCache(LocalPlayer.Character)
end

if LocalPlayer then
	LocalPlayer.CharacterAdded:Connect(function(char)
		table.clear(SavedCollide)
		refreshLocalCharCache(char)
	end)
	LocalPlayer.CharacterRemoving:Connect(function()
		table.clear(SavedCollide)
		cachedChar = nil
		cachedHum = nil
		cachedRoot = nil
	end)
end

