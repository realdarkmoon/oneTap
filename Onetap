-- Config System (Config Name + Saved Configs + Load Configs)
local currentConfigName = "default"
local savedConfigsStore = {}
local savedConfigOrder = {}
local cycleLoadIndex = 0
local configNameBoxRef = nil
local savedConfigsBtnRef = nil
local loadConfigsBtnRef = nil

local CONFIG_FOLDER = "DarkMoonHub_Configs"

local function sanitizeConfigName(raw)
	local cleaned = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("[^%w_%-]", "_")
	if cleaned == "" then
		cleaned = "default"
	end
	return cleaned
end

local function refreshConfigButtonsText()
	local count = #savedConfigOrder
	if savedConfigsBtnRef and savedConfigsBtnRef.Parent then
		savedConfigsBtnRef.Text = count > 0 and ("Save (" .. tostring(count) .. ")") or "Save Config"
	end
	if loadConfigsBtnRef and loadConfigsBtnRef.Parent then
		if count == 0 then
			loadConfigsBtnRef.Text = "No Configs"
		else
			loadConfigsBtnRef.Text = "Load (" .. tostring(count) .. ")"
		end
	end
end

local function persistConfigToDisk(cfgName, encodedJson)
	if typeof(writefile) == "function" then
		pcall(function()
			if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
				if not isfolder(CONFIG_FOLDER) then
					makefolder(CONFIG_FOLDER)
				end
				writefile(CONFIG_FOLDER .. "/" .. cfgName .. ".json", encodedJson)
			else
				writefile("DarkMoonHub_" .. cfgName .. ".json", encodedJson)
			end
		end)
	end
end

local function loadConfigsFromDisk()
	if typeof(listfiles) == "function" and typeof(readfile) == "function" and typeof(isfolder) == "function" then
		pcall(function()
			if isfolder(CONFIG_FOLDER) then
				for _, filePath in ipairs(listfiles(CONFIG_FOLDER)) do
					local fname = tostring(filePath):match("([^/\\]+)%.json$")
					if fname and fname ~= "" then
						local okRead, rawContent = pcall(readfile, filePath)
						if okRead and typeof(rawContent) == "string" then
							local okDecode, decoded = pcall(function()
								return HttpService:JSONDecode(rawContent)
							end)
							if okDecode and typeof(decoded) == "table" then
								if not savedConfigsStore[fname] then
									table.insert(savedConfigOrder, fname)
								end
								savedConfigsStore[fname] = decoded
							end
						end
					end
				end
			end
		end)
	end
end

local function buildConfigSnapshot()
	local togglesSnap = {}
	local bindsSnap = {}
	for tName, ctrl in pairs(toggleControllers) do
		togglesSnap[tName] = ctrl.GetState()
		bindsSnap[tName] = ctrl.GetKeyName()
	end

	local slidersSnap = {}
	for sName, ctrl in pairs(sliderControllers) do
		slidersSnap[sName] = ctrl.GetValue()
	end

	return {
		Name = currentConfigName,
		ThemeIndex = currentThemeIndex,
		ClickSoundIndex = currentClickSoundIndex,
		UIKeybind = ToggleKeybind.Name,
		Toggles = togglesSnap,
		Keybinds = bindsSnap,
		Sliders = slidersSnap
	}
end

local function applyConfigSnapshot(cfg)
	if typeof(cfg) ~= "table" then
		return false
	end

	if typeof(cfg.ThemeIndex) == "number" and PanelThemes[cfg.ThemeIndex] then
		currentThemeIndex = cfg.ThemeIndex
		applyPanelTheme(PanelThemes[currentThemeIndex])
	end

	if typeof(cfg.ClickSoundIndex) == "number" and ClickSoundPresets[cfg.ClickSoundIndex] then
		currentClickSoundIndex = cfg.ClickSoundIndex
		ActiveClickSound = ClickSoundPresets[currentClickSoundIndex]
		if clickSoundBtnRef and clickSoundBtnRef.Parent then
			clickSoundBtnRef.Text = ActiveClickSound.Name
		end
	end

	if typeof(cfg.UIKeybind) == "string" and cfg.UIKeybind ~= "" then
		local okKey, kc = pcall(function() return Enum.KeyCode[cfg.UIKeybind] end)
		if okKey and typeof(kc) == "EnumItem" and kc ~= Enum.KeyCode.Unknown then
			ToggleKeybind = kc
			if keybindBtnRef and keybindBtnRef.Parent then
				keybindBtnRef.Text = ToggleKeybind.Name
			end
		end
	end

	if typeof(cfg.Sliders) == "table" then
		for sName, sVal in pairs(cfg.Sliders) do
			local ctrl = sliderControllers[sName]
			if ctrl and typeof(sVal) == "number" then
				ctrl.SetValue(sVal)
			end
		end
	end

	if typeof(cfg.Toggles) == "table" then
		for tName, tVal in pairs(cfg.Toggles) do
			local ctrl = toggleControllers[tName]
			if ctrl and typeof(tVal) == "boolean" then
				ctrl.SetState(tVal)
			end
		end
	end

	if typeof(cfg.Keybinds) == "table" then
		for tName, kName in pairs(cfg.Keybinds) do
			local ctrl = toggleControllers[tName]
			if ctrl then
				ctrl.SetKeyByName(kName)
			end
		end
	end

	return true
end

