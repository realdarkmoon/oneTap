do
	local btnDragging = false
	local movedEnough = false
	local btnDragInput = nil
	local btnDragStart = nil
	local btnStartPos = nil

	ToggleBtn.MouseEnter:Connect(function()
		if not btnDragging then
			TweenService:Create(MoonToggleHolder, TweenInfo.new(0.14), {Size = UDim2.new(0, 56, 0, 56)}):Play()
		end
	end)

	ToggleBtn.MouseLeave:Connect(function()
		if not btnDragging then
			TweenService:Create(MoonToggleHolder, TweenInfo.new(0.14), {Size = UDim2.new(0, 52, 0, 52)}):Play()
		end
	end)

	ToggleBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			btnDragging = true
			movedEnough = false
			btnDragStart = input.Position
			btnStartPos = MoonToggleHolder.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					local wasDragged = movedEnough
					btnDragging = false
					TweenService:Create(MoonToggleHolder, TweenInfo.new(0.14), {Size = UDim2.new(0, 52, 0, 52)}):Play()
					if not wasDragged then
						playClickSound()
						setWindowVisible(not MainFrame.Visible)
					end
				end
			end)
		end
	end)

	ToggleBtn.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			btnDragInput = input
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if input == btnDragInput and btnDragging then
			local delta = input.Position - btnDragStart
			if delta.Magnitude > 6 then
				movedEnough = true
			end
			MoonToggleHolder.Position = UDim2.new(
				btnStartPos.X.Scale,
				btnStartPos.X.Offset + delta.X,
				btnStartPos.Y.Scale,
				btnStartPos.Y.Offset + delta.Y
			)
		end
	end)
end

UIS.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if activeFeatureBindSlot then
			local slot = activeFeatureBindSlot
			activeFeatureBindSlot = nil
			if input.KeyCode == Enum.KeyCode.Escape then
				slot.SetKey(nil)
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				slot.SetKey(input.KeyCode)
			end
			playClickSound()
			return
		end

		if listeningForMainKeybind then
			listeningForMainKeybind = false
			if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= Enum.KeyCode.Escape then
				ToggleKeybind = input.KeyCode
			end
			if keybindBtnRef and keybindBtnRef.Parent then
				keybindBtnRef.Text = ToggleKeybind.Name
			end
			playClickSound()
			return
		end

		if not gameProcessed then
			if input.KeyCode == ToggleKeybind then
				playClickSound()
				setWindowVisible(not MainFrame.Visible)
				return
			end

			local bindEntry = featureKeybinds[input.KeyCode]
			if bindEntry and bindEntry.Toggle then
				playClickSound()
				bindEntry.Toggle()
			end
		end
	end
end)

