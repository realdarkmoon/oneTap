local savedLightingProps = nil
local createdHDEffects = {}

local function cleanupHDEffects()
	for _, obj in ipairs(createdHDEffects) do
		if obj and obj.Parent then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
	table.clear(createdHDEffects)

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:GetAttribute("DarkMoonHDEffect") == true then
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

